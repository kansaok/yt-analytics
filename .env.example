# Database (lokal: docker compose; produksi: Supabase connection string)
DATABASE_URL="postgresql://analitik:analitik@localhost:5434/analitik?schema=public"
# Redis (lokal: docker compose; produksi: Upstash rediss:// URL)
REDIS_URL="redis://localhost:6381"

# Auth.js
AUTH_SECRET="ganti-dengan-openssl-rand-base64-32"
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kunci AES-256-GCM untuk token OAuth: 32 byte base64 (openssl rand -base64 32).
# Saat rotasi, naikkan versi, isi kunci baru di ENCRYPTION_KEY dan kunci lama di *_PREVIOUS,
# jalankan `npm run crypto:rotate`, lalu hapus dua variabel *_PREVIOUS setelah semua grant berpindah.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEY_PREVIOUS=""
ENCRYPTION_KEY_PREVIOUS_VERSION=1

# Sinkronisasi
SYNC_LOOKBACK_DAYS=90
SYNC_VIDEO_DAILY_LIMIT=50
MAX_CHANNELS_PER_USER=5
MANUAL_SYNC_COOLDOWN_SEC=900
# Rate limit baca per user per menit (PRD 60, dinaikkan ke 120 atas keputusan PO). Mutasi/sync tetap 10.
RATE_LIMIT_READ_PER_MIN=120
# Rate limit gabungan seluruh akun dari satu IP per menit (PRD 300).
RATE_LIMIT_IP_PER_MIN=300

# Hanya untuk pengembangan/e2e: login tanpa Google ke akun seed. JANGAN aktifkan di produksi.
AUTH_DEV_LOGIN=0
